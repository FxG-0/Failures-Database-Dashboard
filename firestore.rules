rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /failures/{docId} {
      allow read, write: if true;
    }
    match /users/{docId} {
      allow read, write: if true;
    }
    match /audit_logs/{docId} {
      allow read, write: if true;
    }
    match /supplemental_info/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

